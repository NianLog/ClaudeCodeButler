{
  "name": "ccb",
  "version": "1.5.1",
  "description": "Claude Code Butler - 多 AI Agent 配置管理工具",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-runner.cjs dev",
    "dev:admin": "node scripts/dev-runner.cjs dev --admin",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "clean:release": "node scripts/clean-release.cjs",
    "registry:sign": "node scripts/sign-registry-bundle.cjs",
    "release:preflight": "node scripts/release-preflight.cjs",
    "release:preflight:preview": "node scripts/release-preflight.cjs --allow-preview-registry",
    "release:metadata": "node scripts/release-metadata.cjs",
    "pack": "npm run clean:release && electron-builder",
    "pack:dir": "npm run clean:release && electron-builder --dir",
    "pack:portable": "npm run clean:release && electron-builder --win portable",
    "pack:installer": "npm run clean:release && electron-builder --win nsis",
    "pack:zip": "npm run clean:release && electron-builder --win zip",
    "pack:win:all": "npm run clean:release && electron-builder --win portable nsis zip --publish=never",
    "dist": "npm run clean:release && electron-builder --publish=never",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:changed": "node scripts/lint-changed.cjs",
    "type-check": "tsc --noEmit",
    "start": "npm run build && electron out/main/index.js",
    "start:admin": "npm run build && node scripts/start-admin.js",
    "start:admin-windows": "powershell.exe -Command \"Start-Process -FilePath 'electron' -ArgumentList 'out/main/index.js' -Verb RunAs\"",
    "start:admin-macos": "osascript -e 'do shell script \"electron out/main/index.js\" with administrator privileges\"",
    "start:admin-linux": "pkexec electron out/main/index.js",
    "start:admin-force": "node scripts/start-admin.js",
    "pack:mac": "npm run clean:release && electron-builder --mac",
    "pack:linux": "npm run clean:release && electron-builder --linux",
    "pack:all": "npm run clean:release && electron-builder --win --mac --linux",
    "dist:mac": "npm run clean:release && electron-builder --mac --publish=never",
    "dist:linux": "npm run clean:release && electron-builder --linux --publish=never",
    "dist:all": "npm run clean:release && electron-builder --win --mac --linux --publish=never"
  },
  "keywords": [
    "claude-code",
    "ai-agent",
    "codex-cli",
    "local-first",
    "configuration-manager",
    "electron",
    "typescript",
    "react"
  ],
  "author": "NianSir",
  "license": "MIT",
  "homepage": "https://github.com/NianLog/ClaudeCodeButler#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/NianLog/ClaudeCodeButler.git"
  },
  "bugs": {
    "url": "https://github.com/NianLog/ClaudeCodeButler/issues"
  },
  "dependencies": {
    "chokidar": "6.0.0",
    "express": "5.3.0",
    "https-proxy-agent": "9.1.0",
    "js-yaml": "5.5.0",
    "node-cron": "4.6.0",
    "smol-toml": "1.9.1",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.7.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "antd": "6.6.7",
    "baseline-browser-mapping": "2.11.32",
    "dayjs": "1.11.23",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "monaco-editor": "0.57.0",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.2",
    "react-window": "2.5.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16",
    "@eslint/js": "10.0.1",
    "globals": "17.13.0",
    "@tailwindcss/postcss": "4.3.3",
    "@ant-design/icons": "6.3.4",
    "use-sync-external-store": "1.7.0"
  },
  "overrides": {
    "@electron/rebuild": "^4.0.2",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7",
    "dompurify": "3.4.17"
  },
  "build": {
    "appId": "com.claudecode.butler",
    "productName": "CCB",
    "compression": "maximum",
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.png",
      "category": "Utility"
    },
    "portable": {
      "artifactName": "CCB-Portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "CCB-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CCB",
      "installerIcon": "resources/icons/ccb.ico",
      "uninstallerIcon": "resources/icons/ccb.ico",
      "runAfterFinish": true
    },
    "files": [
      "out/**/*",
      "!**/*.map",
      "resources/**/*",
      "!resources/icons/README.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ]
  },
  "engines": {
    "node": "^24.22.1"
  },
  "packageManager": "npm@12.2.1"
}
